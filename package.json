  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.118.0",
    "expo": "~58.0.21",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.14",
    "expo-font": "~58.0.11",
    "expo-haptics": "~58.0.7",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.15",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "lucide-react-native": "^1.65.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.13",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint -- --max-warnings 0",
    "find:emoji": "node scripts/find-emoji.mjs",
    "test:emoji": "node scripts/emoji-scan-check.mjs",
    "test:e2e:emoji": "node scripts/playwright-emoji-routes.mjs",
    "audit:after": "node scripts/capture-after-audit.mjs",
    "test:nav-audit": "node scripts/playwright-nav-dead-ends.mjs",
    "test:lobby-e2e": "node scripts/playwright-lobby-two-users.mjs",
    "audit:lobby": "node scripts/capture-lobby-audit.mjs",
    "test": "jest --ci --watchAll=false && npm run test:emoji && npm run test:nav-audit",
    "test:coverage": "jest --ci --watchAll=false --coverage",
    "validate:content": "node scripts/validate-content.mjs",
    "sync:public-content": "node scripts/sync-public-content.mjs",
    "build:web": "npm run validate:content && npm run test:emoji && npm run sync:public-content && expo export --platform web",
    "audit:capture": "node scripts/capture-ui-audit.mjs",
    "format": "prettier --write \"app\" \"src\" \"docs\" \"*.json\" \"*.js\" \"*.ts\" \"*.tsx\""
  },
  "private": true
}
